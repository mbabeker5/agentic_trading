# Settings for the IBKR MCP server (patrickpxp/ibkr-mcp-server, pinned in requirements-312.txt).
# No secrets in here. Loaded by agent/start_mcp.sh.

# Where IB Gateway listens. 4002 is Gateway paper. Live would be 4001, never set that here.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=100
IBKR_ACCOUNT=DUT077572
IBKR_TIMEOUT_SECONDS=20

# Enabled 2026-09-02 at Mo's request, paper account only. Every order still needs confirm=true, and
# transmit defaults to false (parked in Gateway) unless the guardrail layer passes transmit=true.
IBKR_ENABLE_TRADING=true

# The server has no authentication, so it must only listen on this machine.
MCP_BIND_HOST=127.0.0.1
MCP_PORT=8765

TZ=America/New_York

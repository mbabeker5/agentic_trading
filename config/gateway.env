# Which IB Gateway this project is pinned to.
#
# One number, written down once, read by both languages:
#   agent/paths.py           gateway_version() and gateway_app_dir()
#   agent/start_gateway.sh   TWS_MAJOR_VRSN, which IBC needs
#
# IB's macOS installer puts each version in its own folder,
# ~/Applications/IB Gateway 10.45, so the version and the folder are the same
# fact. Upgrading Gateway is: install the new one, change the number here, run
# agent/start_gateway.sh again.
#
# Set IB_GATEWAY_DIR in the environment to override the folder entirely, which
# is what a machine with Gateway in /Applications rather than ~/Applications
# needs.
#
# This file is sourced by bash, so no spaces around the equals sign and no
# quotes that bash would keep.
IB_GATEWAY_VERSION=10.45
